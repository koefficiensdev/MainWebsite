rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function isValidReviewCreate() {
      return request.resource.data.keys().hasOnly([
          'name',
          'message',
          'rating',
          'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.message is string
        && request.resource.data.rating is int
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 60
        && request.resource.data.message.size() >= 10
        && request.resource.data.message.size() <= 320
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.createdAt == request.time;
    }

    function isValidContactCreate() {
      return request.resource.data.keys().hasOnly([
          'name',
          'email',
          'phone',
          'package',
          'message',
          'source',
          'status',
          'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.phone is string
        && request.resource.data.package is string
        && request.resource.data.message is string
        && request.resource.data.source is string
        && request.resource.data.status is string
        && request.resource.data.name.size() <= 80
        && request.resource.data.email.size() >= 5
        && request.resource.data.email.size() <= 160
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.phone.size() <= 32
        && request.resource.data.package.size() <= 80
        && request.resource.data.message.size() <= 1200
        && request.resource.data.source == 'website_contact_form'
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time;
    }

    function isValidCustomPackageCreate() {
      return request.resource.data.keys().hasOnly([
          'name',
          'email',
          'phone',
          'details',
          'pages',
          'features',
          'price',
          'source',
          'status',
          'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.phone is string
        && request.resource.data.details is string
        && request.resource.data.pages is string
        && request.resource.data.features is list
        && request.resource.data.price is int
        && request.resource.data.source is string
        && request.resource.data.status is string
        && request.resource.data.name.size() <= 60
        && request.resource.data.email.size() >= 5
        && request.resource.data.email.size() <= 100
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.phone.size() <= 32
        && request.resource.data.details.size() <= 1200
        && request.resource.data.pages.size() >= 1
        && request.resource.data.pages.size() <= 20
        && request.resource.data.price >= 20000
        && request.resource.data.price <= 600000
        && request.resource.data.source == 'website_custom_package'
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time;
    }


      function isValidAnalyticsCreate() {
        return request.resource.data.keys().hasOnly([
          'sessionId',
          'eventType',
          'pagePath',
          'pageUrl',
          'referrer',
          'source',
          'lang',
          'screenW',
          'screenH',
          'viewportW',
          'viewportH',
          'userAgent',
          'target',
          'value',
          'consentAnalytics',
          'createdAt'
        ])
        && request.resource.data.sessionId is string
        && request.resource.data.eventType is string
        && request.resource.data.pagePath is string
        && request.resource.data.pageUrl is string
        && request.resource.data.referrer is string
        && request.resource.data.source is string
        && request.resource.data.lang is string
        && request.resource.data.screenW is int
        && request.resource.data.screenH is int
        && request.resource.data.viewportW is int
        && request.resource.data.viewportH is int
        && request.resource.data.userAgent is string
        && request.resource.data.target is string
        && request.resource.data.value is string
        && request.resource.data.consentAnalytics is bool
        && request.resource.data.sessionId.size() >= 8
        && request.resource.data.sessionId.size() <= 64
        && request.resource.data.eventType.size() >= 2
        && request.resource.data.eventType.size() <= 40
        && request.resource.data.pagePath.size() <= 200
        && request.resource.data.pageUrl.size() <= 500
        && request.resource.data.referrer.size() <= 500
        && request.resource.data.source.size() <= 120
        && request.resource.data.lang.size() <= 10
        && request.resource.data.userAgent.size() <= 320
        && request.resource.data.target.size() <= 180
        && request.resource.data.value.size() <= 320
        && request.resource.data.screenW >= 0
        && request.resource.data.screenW <= 12000
        && request.resource.data.screenH >= 0
        && request.resource.data.screenH <= 12000
        && request.resource.data.viewportW >= 0
        && request.resource.data.viewportW <= 12000
        && request.resource.data.viewportH >= 0
        && request.resource.data.viewportH <= 12000
        && request.resource.data.consentAnalytics == true
        && request.resource.data.createdAt == request.time;
      }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isValidReviewCreate();
      allow update, delete: if false;
    }

    match /contact_requests/{requestId} {
      allow create: if isValidContactCreate();
      allow read, update, delete: if isAdmin();
    }

    match /custom_packages/{packageId} {
      allow create: if isValidCustomPackageCreate();
      allow read, update, delete: if isAdmin();
    }

    match /orders/{orderId} {
      // Orders are created only by the server-side validated, rate-limited endpoint.
      allow create, delete: if false;
      allow read: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && request.resource.data.status in ['new', 'needs_review', 'qualified', 'cancelled']
        && !(resource.data.status in ['completed', 'cancelled']);
    }

    match /commerce_tasks/{taskId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /payments/{paymentId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /stripe_events/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Outbound mail evidence is server-owned, never an editable CRM status.
    match /outreach_research/{id} { allow read: if isAdmin(); allow write: if false; }
    match /outreach_replies/{id} { allow read: if isAdmin(); allow write: if false; }
    match /outreach_controls/{id} { allow read: if isAdmin(); allow write: if false; }
    match /outreach_messages/{messageId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    function validCampaign() {
      let d = request.resource.data;
      return d.keys().hasAll(['name','platform','destination','creative','budgetMinor','currency','budgetPeriod','status','source','createdAt','updatedAt','createdBy'])
        && d.keys().hasOnly(['name','platform','destination','creative','budgetMinor','currency','budgetPeriod','status','source','createdAt','updatedAt','createdBy'])
        && d.name is string && d.name.size() >= 2 && d.name.size() <= 120
        && d.platform in ['Meta Ads','Google Ads','TikTok Ads','LinkedIn Ads','E-mail','Egyéb']
        && d.destination is string && d.destination.size() <= 500 && d.destination.matches('^https?://.+')
        && d.creative is string && d.creative.size() <= 2000
        && d.budgetMinor is int && d.budgetMinor >= 0 && d.budgetMinor <= 10000000000
        && d.currency == 'HUF' && d.budgetPeriod == 'monthly'
        && d.status in ['planned','active','paused','completed'] && d.source == 'manual'
        && d.createdAt is timestamp && d.updatedAt == request.time && d.createdBy is string;
    }

    match /campaigns/{campaignId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && validCampaign()
        && request.resource.data.createdAt == request.time && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAdmin() && validCampaign()
        && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if false;
    }

    function validExpense() {
      let d = request.resource.data;
      return d.keys().hasAll(['label','amountMinor','currency','incurredOn','category','campaignId','source','createdAt','updatedAt','createdBy'])
        && d.keys().hasOnly(['label','amountMinor','currency','incurredOn','category','campaignId','source','createdAt','updatedAt','createdBy'])
        && d.label is string && d.label.size() >= 2 && d.label.size() <= 120
        && d.amountMinor is int && d.amountMinor > 0 && d.amountMinor <= 10000000000
        && d.currency in ['HUF','EUR','USD']
        && d.incurredOn is string && d.incurredOn.matches('^20[0-9]{2}-[0-9]{2}-[0-9]{2}$')
        && d.category in ['advertising','hosting','ai','invoicing','email','other']
        && d.campaignId is string && d.campaignId.size() <= 80
        && (d.campaignId == '' || exists(/databases/$(database)/documents/campaigns/$(d.campaignId)))
        && d.source == 'manual' && d.createdAt is timestamp && d.updatedAt == request.time && d.createdBy is string;
    }

    match /expenses/{expenseId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && validExpense()
        && request.resource.data.createdAt == request.time && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAdmin() && validExpense()
        && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if false;
    }

    match /leads/{leadId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /production_copy_jobs/{id} { allow read: if isAdmin(); allow write: if false; }
    match /production_jobs/{jobId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /order_workflows/{id} { allow read: if isAdmin(); allow write: if false; }
    match /customer_requests/{id} { allow read: if isAdmin(); allow write: if false; }
    match /customer_notifications/{id} { allow read: if isAdmin(); allow write: if false; }
    match /customer_sessions/{id} { allow read, write: if false; }
    match /customer_access_limits/{id} { allow read, write: if false; }
    match /maintenance_sites/{id} { allow read: if isAdmin(); allow write: if false; }
    match /internal_alerts/{id} { allow read: if isAdmin(); allow write: if false; }
    match /booking_tenants/{id} { allow read: if isAdmin(); allow write: if false; }
    match /booking_notifications/{id} { allow read: if isAdmin(); allow write: if false; }
    match /operations_health/{id} { allow read: if isAdmin(); allow write: if false; }

    match /analytics_events/{eventId} {
      allow create: if isValidAnalyticsCreate();
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /admin_config/stats_access {
      allow read: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
